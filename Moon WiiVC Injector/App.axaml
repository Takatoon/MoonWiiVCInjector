<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Moon_WiiVC_Injector.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="KeyValidBrush" Color="#107c10"/>
          <SolidColorBrush x:Key="KeyInvalidBrush" Color="#c42b1c"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="TextControlBackground" Color="#2B2B2B"/>
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#323232"/>
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2B2B2B"/>
          <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#252525"/>
          <SolidColorBrush x:Key="KeyValidBrush" Color="#6ccb5f"/>
          <SolidColorBrush x:Key="KeyInvalidBrush" Color="#ff99a4"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark"
                               RegionColor="#202020"
                               AltHigh="#2B2B2B"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- Preserve the compact layout; Fluent supplies colors for every control state. -->
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="6,2"/>
    </Style>
    <Style Selector="RadioButton, CheckBox, TabItem">
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="CheckBox.checklist">
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="TextBox.key-box">
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style Selector="TextBox.key-box.valid">
      <Setter Property="BorderBrush" Value="{DynamicResource KeyValidBrush}"/>
    </Style>
    <Style Selector="TextBox.key-box.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource KeyInvalidBrush}"/>
    </Style>
    <Style Selector="TextBox.key-box /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{Binding $parent[TextBox].BorderBrush}"/>
    </Style>
    <Style Selector="TextBox.key-box:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{Binding $parent[TextBox].BorderBrush}"/>
    </Style>
    <Style Selector="TextBox.key-box:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{Binding $parent[TextBox].BorderBrush}"/>
    </Style>
    <Style Selector="TextBox.key-box:read-only /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{Binding $parent[TextBox].BorderBrush}"/>
    </Style>
    <Style Selector="TextBlock.key-status.valid">
      <Setter Property="Foreground" Value="{DynamicResource KeyValidBrush}"/>
    </Style>
    <Style Selector="TextBlock.key-status.invalid">
      <Setter Property="Foreground" Value="{DynamicResource KeyInvalidBrush}"/>
    </Style>
  </Application.Styles>
</Application>
