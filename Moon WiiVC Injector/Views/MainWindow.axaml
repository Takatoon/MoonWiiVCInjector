<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Moon_WiiVC_Injector.ViewModels"
        x:Class="Moon_WiiVC_Injector.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="800"
        MinWidth="800"
        Height="620"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <Style Selector="NumericUpDown.nintendont-number">
      <Setter Property="Background" Value="{DynamicResource ComboBoxBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource ComboBoxForeground}"/>
    </Style>
    <Style Selector="NumericUpDown.nintendont-number:pointerover">
      <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundPointerOver}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrushPointerOver}"/>
    </Style>
    <Style Selector="NumericUpDown.nintendont-number:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}"/>
    </Style>
    <Style Selector="NumericUpDown.nintendont-number:disabled">
      <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundDisabled}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrushDisabled}"/>
      <Setter Property="Foreground" Value="{DynamicResource ComboBoxForegroundDisabled}"/>
    </Style>
    <Style Selector="NumericUpDown.nintendont-number /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="10">
    <!-- Top Area: Radio Buttons & SD Card Button -->
    <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="24" Margin="0,0,0,8">
        <RadioButton Name="WiiRetail" Content="Wii Retail Injection" IsChecked="{Binding IsWiiRetail, Mode=TwoWay}" GroupName="Type"/>
        <RadioButton Name="WiiHomebrew" Content="Wii Homebrew Injection" IsChecked="{Binding IsWiiHomebrew, Mode=TwoWay}" GroupName="Type"/>
        <RadioButton Name="GCRetail" Content="GC Retail Injection" IsChecked="{Binding IsGCRetail, Mode=TwoWay}" GroupName="Type"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
        <RadioButton Name="WiiNAND" Content="vWii NAND Title Launcher" IsChecked="{Binding IsWiiNAND, Mode=TwoWay}" GroupName="Type"/>
      </StackPanel>
      <Button Grid.Row="1" Grid.Column="1" Name="SdCardMenuButton" Content="Nintendont SD Card Menu" Command="{Binding OpenSdCardMenuCommand}" MinWidth="180" Padding="12,5" HorizontalContentAlignment="Center"/>
    </Grid>

    <!-- Tab Control -->
    <TabControl Grid.Row="1" Name="MainTabs" IsEnabled="{Binding !IsBuilding}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Padding="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
      
      <!-- Tab 1: Required Source Files -->
      <TabItem Header="Required Source Files">
        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="10">
          <!-- Game Select -->
          <Button Grid.Row="0" Grid.Column="0" Name="GameSourceButton" Content="Game..." Command="{Binding SelectGameCommand}" IsEnabled="{Binding CanSelectGame}" Width="140" HorizontalContentAlignment="Center" Margin="0,0,0,6"/>
          <TextBox Grid.Row="0" Grid.Column="1" Name="GameSourceDirectory" IsReadOnly="True" Text="{Binding GameSourceText}" VerticalAlignment="Center" Margin="0,0,0,6"/>

          <!-- Icon Select -->
          <Button Grid.Row="1" Grid.Column="0" Name="IconSourceButton" Content="Icon..." Command="{Binding SelectIconCommand}" Width="140" HorizontalContentAlignment="Center" Margin="0,0,0,6"/>
          <TextBox Grid.Row="1" Grid.Column="1" Name="IconSourceDirectory" IsReadOnly="True" Text="{Binding IconSourceText}" VerticalAlignment="Center" Margin="0,0,0,6"/>

          <!-- Banner Select -->
          <Button Grid.Row="2" Grid.Column="0" Name="BannerSourceButton" Content="Banner..." Command="{Binding SelectBannerCommand}" Width="140" HorizontalContentAlignment="Center" Margin="0,0,0,10"/>
          <TextBox Grid.Row="2" Grid.Column="1" Name="BannerSourceDirectory" IsReadOnly="True" Text="{Binding BannerSourceText}" VerticalAlignment="Center" Margin="0,0,0,10"/>

          <!-- Internal Info & Generate Button -->
          <StackPanel Grid.Row="3" Grid.Column="0" Spacing="14" VerticalAlignment="Center">
            <TextBlock Name="IGNText" Text="Internal Game Name:"/>
            <TextBlock Name="ITIDText" Text="Internal Game Title ID:"/>
          </StackPanel>
          <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,130" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
            <TextBox Grid.Row="0" Grid.Column="0" Name="InternalGameName" IsReadOnly="True" Text="{Binding InternalGameNameDisplay}" Margin="0,0,6,4"/>
            <TextBox Grid.Row="1" Grid.Column="0" Name="InternalGameID" IsReadOnly="True" Text="{Binding InternalGameIDDisplay}" Margin="0,0,6,0"/>
            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Name="SettingsButton" Content="Settings" Command="{Binding OpenSettingsCommand}" Width="120" Height="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
          </Grid>

          <!-- Previews & Repo Button -->
          <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="160,*" Margin="0,6,0,0">
            <!-- Left Side: Repo and Icon Preview -->
            <StackPanel Grid.Column="0" Spacing="6" HorizontalAlignment="Left">
              <Button Name="RepoDownload" Content="{Binding RepoDownloadButtonText}" Command="{Binding DownloadRepoCommand}" IsEnabled="{Binding CanRetryDownloadRepo}" Width="140" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
              <TextBlock Text="Icon Preview (128x128)" Margin="0,4,0,2"/>
              <Border Width="128" Height="128" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" HorizontalAlignment="Left">
                <Image Name="IconPreviewBox" Source="{Binding IconPreview}" Width="128" Height="128"/>
              </Border>
            </StackPanel>
            
            <!-- Right Side: Banner Preview -->
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Banner Preview (1280x720)"/>
              <Border Height="176" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <Image Name="BannerPreviewBox" Source="{Binding BannerPreview}" Stretch="Uniform"/>
              </Border>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Tab 2: Optional Source Files -->
      <TabItem Header="Optional Source Files">
        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="10">
          <Button Grid.Row="0" Grid.Column="0" Name="GC2SourceButton" Content="2nd GC Disc" Command="{Binding SelectGC2Command}" IsEnabled="{Binding IsGCSelected}" Width="140" HorizontalContentAlignment="Center" Margin="0,0,0,6"/>
          <TextBox Grid.Row="0" Grid.Column="1" Name="GC2SourceDirectory" IsReadOnly="True" Text="{Binding GC2SourceText}" VerticalAlignment="Center" Margin="0,0,0,6"/>

          <Button Grid.Row="1" Grid.Column="0" Name="BootSoundButton" Content="Boot Sound..." Command="{Binding SelectBootSoundCommand}" Width="140" HorizontalContentAlignment="Center" Margin="0,0,0,6"/>
          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
            <TextBox Grid.Column="0" Name="BootSoundDirectory" IsReadOnly="True" Text="{Binding BootSoundText}" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="2" Name="ToggleBootSoundLoop" Content="Loop" IsChecked="{Binding ToggleBootSoundLoop}" Margin="8,0,0,0"/>
          </Grid>

          <Button Grid.Row="2" Grid.Column="0" Name="LogoSourceButton" Content="Boot Logo..." Command="{Binding SelectLogoCommand}" Width="140" HorizontalContentAlignment="Center" Margin="0,0,0,6"/>
          <TextBox Grid.Row="2" Grid.Column="1" Name="LogoSourceDirectory" IsReadOnly="True" Text="{Binding LogoSourceText}" VerticalAlignment="Center" Margin="0,0,0,6"/>

          <Button Grid.Row="3" Grid.Column="0" Name="DrcSourceButton" Content="GamePad Banner..." Command="{Binding SelectDrcCommand}" Width="140" HorizontalContentAlignment="Center" Margin="0,0,0,10"/>
          <TextBox Grid.Row="3" Grid.Column="1" Name="DrcSourceDirectory" IsReadOnly="True" Text="{Binding DrcSourceText}" VerticalAlignment="Center" Margin="0,0,0,10"/>

          <!-- Optional Previews -->
          <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="180,*" Margin="0,10,0,0">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="Boot Logo Preview (170x42)"/>
              <Border Width="170" Height="42" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" HorizontalAlignment="Left">
                <Image Name="LogoPreviewBox" Source="{Binding LogoPreview}" Stretch="Uniform"/>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="GamePad Banner Preview (854x480)"/>
              <Border Height="140" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <Image Name="DrcPreviewBox" Source="{Binding DrcPreview}" Stretch="Uniform"/>
              </Border>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Tab 3: GamePad/Meta Options -->
      <TabItem Header="GamePad/Meta Options">
        <StackPanel Margin="10" Spacing="10">
          <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Padding="10">
            <StackPanel Spacing="6">
              <TextBlock Text="GamePad Emulation Mode (Only applicable for Wii Retail Injections / vWii NAND Title Launcher)" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                <RadioButton Grid.Row="0" Grid.Column="0" Name="NoGamePadEmu" Content="No GamePad emulation, Wii Remotes only" IsChecked="{Binding NoGamePadEmu}" GroupName="GPEmu"/>
                <RadioButton Grid.Row="0" Grid.Column="1" Name="ForceCC" Content="*Force Classic Controller Connected" IsChecked="{Binding ForceCC}" GroupName="GPEmu"/>
                <RadioButton Grid.Row="1" Grid.Column="0" Name="CCEmu" Content="Classic Controller Emulation" IsChecked="{Binding CcEmu}" GroupName="GPEmu"/>
                <RadioButton Grid.Row="1" Grid.Column="1" Name="ForceNoCC" Content="*Force No Classic Controller" IsChecked="{Binding ForceNoCC}" GroupName="GPEmu"/>
                <RadioButton Grid.Row="2" Grid.Column="0" Name="HorWiiMote" Content="**Horizontal Wii Remote emulation" IsChecked="{Binding HorWiiMote}" GroupName="GPEmu"/>
                <RadioButton Grid.Row="2" Grid.Column="1" Name="VerWiiMote" Content="**Vertical Wii Remote Emulation" IsChecked="{Binding VerWiiMote}" GroupName="GPEmu"/>
              </Grid>
            </StackPanel>
          </Border>

          <CheckBox Name="LRPatch" Content="Swap L &amp; R with ZL &amp; ZR" IsChecked="{Binding LrPatch}"/>

          <StackPanel Spacing="4">
            <TextBlock Text="Name to use for Packaged Title (ACCENT CHARACTERS NOT SUPPORTED)"/>
            <TextBox Name="PackedTitleLine1" Text="{Binding PackedTitleLine1}"/>
            <CheckBox Name="EnablePackedLine2" Content="Use Line 2" IsChecked="{Binding EnablePackedLine2}"/>
            <TextBox Name="PackedTitleLine2" Text="{Binding PackedTitleLine2}" PlaceholderText="(Optional) Line 2"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Pre-generated Title ID (Changing this is not recommended)"/>
            <TextBox Name="PackedTitleIDLine" Text="{Binding PackedTitleIDLine}" Width="200" HorizontalAlignment="Left"/>
          </StackPanel>
        </StackPanel>
      </TabItem>

      <!-- Tab 4: Advanced -->
      <TabItem Header="Advanced">
        <StackPanel Margin="10" Spacing="10">
          <TextBlock Text="Wii Retail Injection / vWii NAND Title Launcher Patches" FontWeight="SemiBold"/>
          <CheckBox Name="Wiimmfi" Content="Patch game to use the Wiimmfi server for online play (Wii Retail only)" IsChecked="{Binding Wiimmfi}"/>
          <CheckBox Name="WiiVMC" Content="Patch video mode with Wii-VMC (Wii Retail only, opens new window)" IsChecked="{Binding WiiVMC}"/>
          <CheckBox Name="DisableGamePad" Content="Don't use GamePad as controller (Won't prompt for usage)" IsChecked="{Binding DisableGamePad}"/>
          <CheckBox Name="DisableTrimming" Content="Don't trim game output (Wii Retail only)" IsChecked="{Binding DisableTrimming}"/>
          <CheckBox Name="C2WPatchFlag" Content="Enable cafe2wii patching (NOT RECOMMENDED)" IsChecked="{Binding C2WPatchFlag}"/>

          <Border Name="AncastKeyBorder" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Padding="10" Margin="0,10,0,0" IsVisible="{Binding IsAncastKeyVisible}">
            <StackPanel Spacing="6">
              <TextBlock Text="Wii U Ancast Key" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Name="AncastKey" Classes="key-box" Text="{Binding AncastKey}" IsReadOnly="{Binding IsAncastKeyReadOnly}" Classes.valid="{Binding IsAncastKeyValid}" Classes.invalid="{Binding IsAncastKeyInvalid}" DoubleTapped="OnKeyTextBoxDoubleTapped"/>
                <Button Grid.Column="1" Name="SaveAncastKeyButton" Content="Save Key" Command="{Binding SaveAncastKeyCommand}" IsEnabled="{Binding CanSaveAncastKey}" Margin="4,0,0,0"/>
              </Grid>
              <TextBlock Text="{Binding AncastKeyStatusText}" Classes="key-status" Classes.valid="{Binding IsAncastKeyValid}" Classes.invalid="{Binding IsAncastKeyInvalid}" FontSize="11" FontWeight="SemiBold" Margin="2,-2,0,0" IsVisible="{Binding AncastKeyStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <!-- Tab 5: Nintendont (GameCube only) -->
      <TabItem Header="Nintendont" IsEnabled="{Binding IsGCSelected}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
          <StackPanel Margin="10" Spacing="12">
            <StackPanel Spacing="8">
              <CheckBox Name="DisableNintendontAutoboot" Content="Disable Autoboot" IsChecked="{Binding DisableNintendontAutoboot}" ToolTip.Tip="Embedded config requires autoboot."/>
              <CheckBox Name="EmbedNintendontConfig" Content="Embed custom config" IsChecked="{Binding EmbedNintendontConfig}" IsEnabled="{Binding !DisableNintendontAutoboot}" ToolTip.Tip="An SD game-specific config (XXXX.bin) takes precedence."/>
            </StackPanel>
            <Grid IsEnabled="{Binding !DisableNintendontAutoboot}">
              <Grid IsEnabled="{Binding EmbedNintendontConfig}">
                <Grid DataContext="{Binding NintendontConfig}" x:DataType="vm:NintendontConfigViewModel" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                  <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,6,12">
                    <Border Grid.Row="0" Margin="0,0,0,12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Memory Card" FontWeight="SemiBold"/>
                        <CheckBox Content="Memcard Emulation" IsChecked="{Binding MemcardEmulation}" ToolTip.Tip="Save game progress to virtual GameCube memory card files. Required for saving on Wii U, which has no physical GameCube memory card slots."/>
                        <StackPanel Spacing="8" IsEnabled="{Binding MemcardEmulation}">
                          <Grid Background="Transparent" ToolTip.Tip="Capacity of the virtual memory card in save blocks. Larger than 251 may cause compatibility issues. Does not resize existing cards." ColumnDefinitions="*,170">
                            <TextBlock Text="Memcard Blocks" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding MemcardBlocksIndex}" HorizontalAlignment="Stretch">
                              <ComboBoxItem Content="59"/>
                              <ComboBoxItem Content="123"/>
                              <ComboBoxItem Content="251"/>
                              <ComboBoxItem Content="507 (Unstable)"/>
                              <ComboBoxItem Content="1019 (Unstable)"/>
                              <ComboBoxItem Content="2043 (Unstable)"/>
                            </ComboBox>
                          </Grid>
                          <CheckBox Content="Multi Memcard" IsChecked="{Binding MultiMemcard}" ToolTip.Tip="Share a card between games, separated by Japan and USA/PAL. Off uses one card per game."/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Controllers &amp; Language" FontWeight="SemiBold"/>
                        <Grid Background="Transparent" ToolTip.Tip="Assign the Wii U GamePad to player 1–4. Select None to disable it as a GameCube controller." ColumnDefinitions="*,170">
                          <TextBlock Text="GamePad Slot" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" SelectedIndex="{Binding GamepadSlotIndex}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Player 1"/>
                            <ComboBoxItem Content="Player 2"/>
                            <ComboBoxItem Content="Player 3"/>
                            <ComboBoxItem Content="Player 4"/>
                            <ComboBoxItem Content="None"/>
                          </ComboBox>
                        </Grid>
                        <CheckBox Content="Wiimote CC Rumble" IsChecked="{Binding CcRumble}" ToolTip.Tip="Enable rumble on the Wii Remote when using a connected Classic Controller. The Classic Controller itself does not vibrate."/>
                        <Grid Background="Transparent" ToolTip.Tip="Select the language reported to the game. The game must support the selected language; this does not translate it." ColumnDefinitions="*,170">
                          <TextBlock Text="Language" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" SelectedIndex="{Binding LanguageIndex}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Automatic"/>
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="German"/>
                            <ComboBoxItem Content="French"/>
                            <ComboBoxItem Content="Spanish"/>
                            <ComboBoxItem Content="Italian"/>
                            <ComboBoxItem Content="Dutch"/>
                          </ComboBox>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Border Grid.Row="0" Grid.Column="1" Margin="6,0,0,12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Video" FontWeight="SemiBold"/>
                      <Grid Background="Transparent" ToolTip.Tip="Choose automatic video selection, force the selected Video Type, force it with a deflicker filter, or leave video mode unforced." ColumnDefinitions="*,170">
                        <TextBlock Text="Video Mode" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding VideoModeIndex}" HorizontalAlignment="Stretch">
                          <ComboBoxItem Content="Auto"/>
                          <ComboBoxItem Content="Force"/>
                          <ComboBoxItem Content="Force (Deflicker)"/>
                          <ComboBoxItem Content="None"/>
                        </ComboBox>
                      </Grid>
                      <Grid Background="Transparent" ToolTip.Tip="Output video format to request in Force or Force (Deflicker) mode." ColumnDefinitions="*,170" IsEnabled="{Binding CanSelectVideoType}">
                        <TextBlock Text="Video Type" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding VideoTypeIndex}" HorizontalAlignment="Stretch">
                          <ComboBoxItem Content="NTSC"/>
                          <ComboBoxItem Content="MPAL"/>
                          <ComboBoxItem Content="PAL50"/>
                          <ComboBoxItem Content="PAL60"/>
                        </ComboBox>
                      </Grid>
                      <CheckBox Content="Auto Video Width" IsChecked="{Binding AutoVideoWidth}" ToolTip.Tip="Let Nintendont choose the output image width. Disable to set Video Width manually."/>
                      <Grid Background="Transparent" ToolTip.Tip="Adjust the horizontal output image width. Does not change height or internal rendering resolution." ColumnDefinitions="*,170" IsEnabled="{Binding !AutoVideoWidth}">
                        <TextBlock Text="Video Width" VerticalAlignment="Center"/>
                        <NumericUpDown Classes="nintendont-number" Grid.Column="1" Value="{Binding VideoWidth}" Minimum="640" Maximum="720" Increment="2" FormatString="0"/>
                      </Grid>
                      <Grid Background="Transparent" ToolTip.Tip="Shift the output image horizontally. Does not change its size." ColumnDefinitions="*,170">
                        <TextBlock Text="Video Offset" VerticalAlignment="Center"/>
                        <NumericUpDown Classes="nintendont-number" Grid.Column="1" Value="{Binding VideoOffset}" Minimum="-20" Maximum="20" Increment="1" FormatString="0"/>
                      </Grid>
                      <CheckBox Content="Wii U Widescreen" IsChecked="{Binding WiiUWidescreen}" ToolTip.Tip="Set Wii U output to 16:9 instead of 4:3. Games still rendering in 4:3 will appear stretched."/>
                      <CheckBox Content="Force Widescreen" IsChecked="{Binding ForceWidescreen}" ToolTip.Tip="Patches game rendering; may cause visual issues or crashes."/>
                      <CheckBox Content="Force Progressive" IsChecked="{Binding ForceProgressive}" ToolTip.Tip="May cause a black screen in incompatible games."/>
                      <CheckBox Content="Patch PAL50" IsChecked="{Binding PatchPal50}" IsEnabled="{Binding CanPatchPal50}" ToolTip.Tip="Allow PAL50 video modes to be patched to the selected Video Type, or to progressive output when Force Progressive is enabled. May cause compatibility issues."/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="0" Margin="0,0,6,12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Compatibility" FontWeight="SemiBold"/>
                      <CheckBox Content="Unlock Read Speed" IsChecked="{Binding UnlockReadSpeed}" ToolTip.Tip="May affect game compatibility."/>
                      <CheckBox Content="Skip IPL" IsChecked="{Binding SkipIpl}" ToolTip.Tip="Boot directly into the game instead of loading an available GameCube IPL or Triforce boot ROM. May affect boot compatibility."/>
                      <CheckBox Content="TRI Arcade Mode" IsChecked="{Binding TriArcadeMode}" ToolTip.Tip="Enable arcade behavior for supported Triforce games. Has no effect on regular GameCube games."/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="1" Margin="6,0,0,12" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Cheats &amp; Network" FontWeight="SemiBold"/>
                      <CheckBox Content="Enable Cheats" IsChecked="{Binding Cheats}" ToolTip.Tip="Use automatic cheat-file lookup; no custom cheat path."/>
                      <CheckBox Content="BBA Emulation" IsChecked="{Binding BbaEmulation}" ToolTip.Tip="Emulate the GameCube Broadband Adapter for network features in supported games. Uses the Wii U's network connection."/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="8">
                      <TextBlock Grid.ColumnSpan="2" Text="Diagnostics" FontWeight="SemiBold"/>
                      <CheckBox Grid.Row="1" Grid.Column="0" Content="OSReport" IsChecked="{Binding OsReport}" ToolTip.Tip="Enable diagnostic messages emitted by the game. Intended for troubleshooting."/>
                      <CheckBox Grid.Row="1" Grid.Column="1" Content="Log" IsChecked="{Binding Log}" ToolTip.Tip="Write Nintendont diagnostic messages to ndebug.log on the storage device. Intended for troubleshooting."/>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab 6: Build Title -->
      <TabItem Header="Build Title">
        <Grid ColumnDefinitions="*,*" Margin="10">
          <StackPanel Grid.Column="0" Spacing="8">
            <TextBlock Text="Requirements Checklist" FontWeight="SemiBold"/>
            <CheckBox Name="SourceCheck" Classes="checklist" Content="Source files specified" IsChecked="{Binding SourceCheck}" IsHitTestVisible="False" Focusable="False"/>
            <CheckBox Name="MetaCheck" Classes="checklist" Content="Metadata specified" IsChecked="{Binding MetaCheck}" IsHitTestVisible="False" Focusable="False"/>
            <CheckBox Name="KeysCheck" Classes="checklist" Content="Common &amp; Title keys specified" IsChecked="{Binding KeysCheck}" IsHitTestVisible="False" Focusable="False"/>
            <CheckBox Name="AdvanceCheck" Classes="checklist" Content="Advanced configuration done" IsChecked="{Binding AdvanceCheck}" IsHitTestVisible="False" Focusable="False"/>

            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" Padding="10" Margin="0,10,0,0">
              <StackPanel Spacing="6">
                <TextBlock Text="Keys Configuration" FontWeight="SemiBold"/>
                <TextBlock Text="Wii U Common Key:"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Name="WiiUCommonKey" Classes="key-box" Text="{Binding WiiUCommonKey}" IsReadOnly="{Binding IsCommonKeyReadOnly}" Classes.valid="{Binding IsCommonKeyValid}" Classes.invalid="{Binding IsCommonKeyInvalid}" DoubleTapped="OnKeyTextBoxDoubleTapped"/>
                  <Button Grid.Column="1" Name="SaveCommonKeyButton" Content="Save" Command="{Binding SaveCommonKeyCommand}" IsEnabled="{Binding CanSaveCommonKey}" Margin="4,0,0,0"/>
                </Grid>
                <TextBlock Text="{Binding CommonKeyStatusText}" Classes="key-status" Classes.valid="{Binding IsCommonKeyValid}" Classes.invalid="{Binding IsCommonKeyInvalid}" FontSize="11" FontWeight="SemiBold" Margin="2,-2,0,0" IsVisible="{Binding CommonKeyStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <TextBlock Text="Base Game Title Key (USA / EUR Rhythm Heaven):" Margin="0,4,0,0"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Name="TitleKey" Classes="key-box" Text="{Binding TitleKey}" IsReadOnly="{Binding IsTitleKeyReadOnly}" Classes.valid="{Binding IsTitleKeyValid}" Classes.invalid="{Binding IsTitleKeyInvalid}" DoubleTapped="OnKeyTextBoxDoubleTapped"/>
                  <Button Grid.Column="1" Name="SaveTitleKeyButton" Content="Save" Command="{Binding SaveTitleKeyCommand}" IsEnabled="{Binding CanSaveTitleKey}" Margin="4,0,0,0"/>
                </Grid>
                <TextBlock Text="{Binding TitleKeyStatusText}" Classes="key-status" Classes.valid="{Binding IsTitleKeyValid}" Classes.invalid="{Binding IsTitleKeyInvalid}" FontSize="11" FontWeight="SemiBold" Margin="2,-2,0,0" IsVisible="{Binding TitleKeyStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <Button Grid.Column="0" Name="TheBigOneTM" Content="BUILD TITLE" Command="{Binding BuildCommand}" IsEnabled="{Binding CanBuild}" Height="50" FontSize="14" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
              <Button Grid.Column="1" Name="CancelBuildButton" Content="Cancel" Command="{Binding CancelBuildCommand}" IsVisible="{Binding CanCancel}" IsEnabled="{Binding CanCancel}" Height="50" Width="80" Margin="8,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>
            <ProgressBar Name="BuildProgress" Value="{Binding BuildProgress}" Height="20" Minimum="0" Maximum="100" ShowProgressText="True"/>
            <TextBlock Name="BuildStatus" Text="{Binding BuildStatus}" TextAlignment="Center" FontWeight="SemiBold"/>
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- Tab 7: Build Logs -->
      <TabItem Header="Build Logs">
        <Grid RowDefinitions="*,Auto" Margin="10">
          <TextBox Grid.Row="0" Name="LogOutputBox" Text="{Binding LogOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" HorizontalAlignment="Right">
            <Button Name="CopyLogsButton" Content="Copy Logs" Command="{Binding CopyLogsCommand}" Width="100" HorizontalContentAlignment="Center"/>
            <Button Name="ClearLogsButton" Content="Clear" Command="{Binding ClearLogsCommand}" Width="80" HorizontalContentAlignment="Center"/>
            <Button Name="OpenLogFolderButton" Content="Open Log Folder" Command="{Binding OpenLogFolderCommand}" Width="130" HorizontalContentAlignment="Center"/>
          </StackPanel>
        </Grid>
      </TabItem>
      
    </TabControl>
  </Grid>
</Window>
