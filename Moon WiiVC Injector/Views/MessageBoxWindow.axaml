<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Moon_WiiVC_Injector.MessageBoxWindow"
        Title="Message"
        Width="500"
        Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <Grid RowDefinitions="*,Auto" Margin="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
      <SelectableTextBlock Name="MessageText" TextWrapping="Wrap"/>
    </ScrollViewer>
    <StackPanel Name="ButtonsPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="OkButton" Content="OK" Width="80" HorizontalContentAlignment="Center" Click="OnOkClick" IsVisible="False"/>
      <Button Name="YesButton" Content="Yes" Width="80" HorizontalContentAlignment="Center" Click="OnYesClick" IsVisible="False"/>
      <Button Name="NoButton" Content="No" Width="80" HorizontalContentAlignment="Center" Click="OnNoClick" IsVisible="False"/>
    </StackPanel>
  </Grid>
</Window>
