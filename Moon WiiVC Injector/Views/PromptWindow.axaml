<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Moon_WiiVC_Injector.PromptWindow"
        Title="Input Required"
        Width="350"
        Height="150"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Grid RowDefinitions="*,Auto,Auto" Margin="16" KeyboardNavigation.TabNavigation="Cycle">
    <TextBlock Name="PromptText" Text="Enter value:" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,8"/>
    <TextBox Name="InputTextBox" Grid.Row="1" Width="300" HorizontalAlignment="Left" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Spacing="8">
      <Button Name="OkButton" Content="OK" Width="80" HorizontalContentAlignment="Center" Click="OnOkClick"/>
      <Button Name="CancelButton" Content="Cancel" Width="80" HorizontalContentAlignment="Center" Click="OnCancelClick"/>
    </StackPanel>
  </Grid>
</Window>
