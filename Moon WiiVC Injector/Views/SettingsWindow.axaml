<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Moon_WiiVC_Injector.ViewModels"
        x:Class="Moon_WiiVC_Injector.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Application Settings"
        Width="400"
        Height="330"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="16">
    <TextBlock Text="Banners Repository" Margin="0,0,0,4"/>
    <TextBox Grid.Row="1" Text="{Binding BannersRepository}" Width="368" HorizontalAlignment="Left" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,0,0,16"/>
    
    <TextBlock Grid.Row="2" Text="Output Directory (leave empty to always ask)" Margin="0,0,0,4"/>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <TextBox Text="{Binding OutputDir}" Width="280" HorizontalAlignment="Left" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOutputFolderCommand}" Width="80" HorizontalContentAlignment="Center" Margin="8,0,0,0"/>
    </Grid>

    <TextBlock Grid.Row="4" Text="Temporary Directory (leave empty for disk default)" Margin="0,0,0,4"/>
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
      <TextBox Text="{Binding TempDir}" Width="280" HorizontalAlignment="Left" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseTempFolderCommand}" Width="80" HorizontalContentAlignment="Center" Margin="8,0,0,0"/>
    </Grid>

    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="OK" Command="{Binding SaveCommand}" Width="80" HorizontalContentAlignment="Center"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" HorizontalContentAlignment="Center"/>
    </StackPanel>
  </Grid>
</Window>

