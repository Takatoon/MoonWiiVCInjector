<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Moon_WiiVC_Injector.ViewModels"
        xmlns:views="using:Moon_WiiVC_Injector"
        x:Class="Moon_WiiVC_Injector.SdCardMenuAvalonia"
        x:DataType="vm:SdCardViewModel"
        Title="Nintendont SD Card Menu..."
        Width="800" MinWidth="800" Height="700"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
    <StackPanel Margin="10" Spacing="12">
      <TextBlock Text="Choose your SD Card"/>
      <Grid ColumnDefinitions="*,Auto">
        <ComboBox ItemsSource="{Binding Drives}" SelectedIndex="{Binding SelectedDriveIndex}" SelectedItem="{Binding SelectedDrive}" HorizontalAlignment="Stretch"/>
        <Button Grid.Column="1" Content="Reload Drive List" Command="{Binding ReloadDrivesCommand}" Margin="8,0,0,0"/>
      </Grid>
      <TextBlock Text="{Binding ActionStatus}" TextAlignment="Center"/>
      <Button Content="Download Latest Nintendont from GitHub" Command="{Binding UpdateNintendontCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
      <views:NintendontConfigView DataContext="{Binding NintendontConfig}"/>
      <Button Content="Generate global config (nincfg.bin)" Command="{Binding GenerateConfigCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    </StackPanel>
  </ScrollViewer>
</Window>
